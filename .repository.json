{
  "version": 1,
  "runtime": {
    "kind": "node",
    "version_source": ".node-version",
    "probe": [
      "node",
      "--version"
    ]
  },
  "additional_runtimes": [
    {
      "kind": "python",
      "version_source": ".python-version",
      "probe": [
        "python3",
        "--version"
      ]
    }
  ],
  "dependencies": {
    "required": true,
    "lockfile": "requirements-schema-tests.txt",
    "immutable_install": [
      "node",
      "scripts/setup-schema-tests.mjs"
    ]
  },
  "validation": {
    "changed": [
      "bash",
      "scripts/validate.sh",
      "changed"
    ],
    "full": [
      "bash",
      "scripts/validate.sh",
      "full"
    ]
  },
  "capabilities": [],
  "gates": {
    "shared": [
      ".repository-suite-plan.json",
      "scripts/*",
      ".github/workflows/test.yml",
      ".githooks/**"
    ],
    "inert": [
      "AGENTS.md",
      "README.md",
      ".gitignore"
    ],
    "units": {
      "node-test": {
        "lane": "fast",
        "inputs": [
          "review/**",
          "classify-claude-review/**"
        ]
      },
      "ci-run-context": {
        "lane": "fast",
        "inputs": [
          ".github/actions/ci-run-context/**",
          "scripts/run-python.mjs"
        ]
      },
      "ci-run-context-schema": {
        "lane": "fast",
        "inputs": [
          ".github/actions/ci-run-context/**",
          "scripts/test_run_context_schema.py",
          "scripts/run-python.mjs"
        ]
      }
    }
  },
  "ci": {
    "validation": [
      "bash",
      "scripts/run-ci-checks.sh"
    ]
  }
}
